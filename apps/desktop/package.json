{
  "name": "@hasarbotu/desktop",
  "version": "0.1.39",
  "private": true,
  "type": "module",
  "description": "HasarBotu V2 ince Electron kabuğu (ADR-Q06): güvenli BrowserWindow + loopback aynı-origin köprüsü",
  "author": "Ömer Faruk İŞLEYEN",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "start": "electron .",
    "package:win": "node ../../scripts/prepare-desktop-distribution.mjs && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@hasarbotu/contracts": "*",
    "@hasarbotu/desktop-bridge": "*"
  },
  "devDependencies": {
    "@hasarbotu/api": "*",
    "@hasarbotu/database": "*",
    "@hasarbotu/domain": "*",
    "@types/node": "24.13.3",
    "electron": "43.7.11",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hasarbotu.desktop",
    "productName": "HasarBotu",
    "copyright": "Copyright (c) 2026 Ömer Faruk İŞLEYEN. All rights reserved.",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE-HasarBotu.txt"
      },
      {
        "from": "build-resources/office-folder-roots.json",
        "to": "folder-roots.json"
      },
      {
        "from": "build-resources/office-connection.json",
        "to": "office-connection.json"
      },
      {
        "from": "distribution",
        "to": ".",
        "filter": [
          "*.ps1",
          "*.psm1"
        ]
      },
      {
        "from": "../../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "HasarBotu-Setup-${version}.${ext}"
    }
  },
  "license": "UNLICENSED"
}
