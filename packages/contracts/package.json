{
  "name": "@hasarbotu/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 surumlu API sozlesmeleri ve Zod 4 runtime dogrulama siniri",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./desktop-release-schema": {
      "types": "./dist/v1/desktop-release.d.ts",
      "import": "./dist/v1/desktop-release.js"
    },
    "./desktop-update-state": {
      "types": "./dist/v1/desktop-update-state.d.ts",
      "import": "./dist/v1/desktop-update-state.js"
    },
    "./assistant-appearance": {
      "types": "./dist/v1/assistant-appearance-values.d.ts",
      "import": "./dist/v1/assistant-appearance-values.js"
    },
    "./assistant-appearance-schema": {
      "types": "./dist/v1/assistant-appearance.d.ts",
      "import": "./dist/v1/assistant-appearance.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "schema": "npm run build && node dist/generate-json-schema.js",
    "schema:fixtures": "npm run build && node dist/generate-json-schema.js --out test/fixtures/json-schema"
  },
  "dependencies": {
    "@hasarbotu/domain": "*",
    "zod": "4.4.3"
  }
}
