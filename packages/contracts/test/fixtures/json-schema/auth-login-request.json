{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 254,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    },
    "password": {
      "type": "string",
      "minLength": 10,
      "maxLength": 128
    }
  },
  "required": [
    "email",
    "password"
  ],
  "additionalProperties": false
}
