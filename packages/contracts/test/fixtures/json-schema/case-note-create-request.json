{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "noteType": {
      "type": "string",
      "enum": [
        "internal",
        "contact"
      ]
    },
    "subject": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    }
  },
  "required": [
    "noteType",
    "subject",
    "body"
  ],
  "additionalProperties": false
}
