{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedCaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedLocationVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "targetWorkflowStage": {
      "default": "new_notification",
      "type": "string",
      "enum": [
        "new_notification",
        "parts_and_labor",
        "under_repair",
        "under_investigation",
        "total_loss"
      ]
    }
  },
  "required": [
    "expectedCaseVersion",
    "expectedLocationVersion",
    "reason",
    "targetWorkflowStage"
  ],
  "additionalProperties": false
}
