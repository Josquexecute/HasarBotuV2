{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedCaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedLocationVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "targetWorkflowStage": {
      "default": "new_notification",
      "type": "string",
      "enum": [
        "new_notification",
        "parts_and_labor",
        "under_repair",
        "under_investigation",
        "total_loss",
        "ready_to_close"
      ]
    },
    "replaceFailedOperationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    }
  },
  "required": [
    "expectedCaseVersion",
    "expectedLocationVersion",
    "reason",
    "targetWorkflowStage"
  ],
  "additionalProperties": false
}
