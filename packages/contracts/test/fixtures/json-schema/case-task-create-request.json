{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "priority": {
      "default": "normal",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "assignedUserId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "dueDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    }
  },
  "required": [
    "title",
    "priority",
    "assignedUserId",
    "dueDate"
  ],
  "additionalProperties": false
}
