{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "caseType": {
      "type": "string",
      "enum": [
        "traffic",
        "casco"
      ]
    },
    "workflowStage": {
      "type": "string",
      "enum": [
        "new_notification",
        "parts_and_labor",
        "under_repair",
        "under_investigation",
        "total_loss",
        "ready_to_close"
      ]
    },
    "followUpDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-hasarbotu-runtime-validation": "calendar-date-validity"
        },
        {
          "type": "null"
        }
      ]
    },
    "notificationFormNumber": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=.*[A-Za-z0-9])[^\\\\\u0000-\u001f-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "insurerClaimNumber": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?=.*[A-Za-z0-9])[^\\\\\u0000-\u001f-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "responsibleUserId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expertUserId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serviceId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "serviceDetails": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "phone": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "address": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "serviceRevision": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "insurerId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lossDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-hasarbotu-runtime-validation": "calendar-date-validity"
        },
        {
          "type": "null"
        }
      ]
    },
    "notificationDate": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "x-hasarbotu-runtime-validation": "calendar-date-validity"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "expectedVersion"
  ],
  "additionalProperties": false
}
