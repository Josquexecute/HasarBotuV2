{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "search": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "caseType": {
      "type": "string",
      "enum": [
        "traffic",
        "casco"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "new_notification",
        "vehicle_or_service_pending",
        "inspection_pending",
        "damage_assessment",
        "parts_and_labor",
        "repair_approval_pending",
        "under_repair",
        "reporting",
        "closing_documents",
        "ready_to_close",
        "closed"
      ]
    },
    "responsibleUserId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "serviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "followUpFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    },
    "followUpTo": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    },
    "sortBy": {
      "default": "updatedAt",
      "type": "string",
      "enum": [
        "updatedAt",
        "followUpDate",
        "officeCaseNumber",
        "plate"
      ]
    },
    "sortDirection": {
      "default": "desc",
      "type": "string",
      "enum": [
        "asc",
        "desc"
      ]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "pageSize": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "sortBy",
    "sortDirection",
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
