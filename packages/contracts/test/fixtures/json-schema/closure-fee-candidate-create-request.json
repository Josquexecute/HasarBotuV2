{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedCaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "candidateAmountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000000
    },
    "sourceDocumentVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "sourcePage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  },
  "required": [
    "expectedCaseVersion",
    "candidateAmountMinor",
    "sourceDocumentVersionId",
    "sourcePage"
  ],
  "additionalProperties": false
}
