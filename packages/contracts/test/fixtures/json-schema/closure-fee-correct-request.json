{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "approvedAmountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000000000
    },
    "sourceDocumentVersionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "sourcePage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "expectedVersion",
    "approvedAmountMinor",
    "sourceDocumentVersionId",
    "sourcePage",
    "reason",
    "confirmed"
  ],
  "additionalProperties": false
}
