{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "draftType": {
      "type": "string",
      "enum": [
        "repair_approval_request",
        "missing_document_request",
        "preliminary_report_notice",
        "service_change_notice",
        "deductible_service_part_notice",
        "portal_deductible_note",
        "closure_documents_request",
        "case_status_update",
        "recourse_documents_request",
        "pert_evaluation_notice",
        "custom_instruction"
      ]
    },
    "templateVersion": {
      "type": "string",
      "const": "email-draft-template/1.0.0"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "sourceRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "recipientStatus": {
      "type": "string",
      "const": "control_required"
    },
    "recipientReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "missingRequirementCodes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "controlRequiredRequirementCodes": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "attachmentOptions": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "enum": [
              "document_version",
              "photo"
            ]
          },
          "resourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "documentType": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "mimeType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "preferred": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "const": "ready"
          }
        },
        "required": [
          "resourceType",
          "resourceId",
          "documentType",
          "displayName",
          "mimeType",
          "byteSize",
          "preferred",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "previewHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requiresHumanReview": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "caseId",
    "caseVersion",
    "draftType",
    "templateVersion",
    "subject",
    "body",
    "sourceRule",
    "recipientStatus",
    "recipientReason",
    "missingRequirementCodes",
    "controlRequiredRequirementCodes",
    "attachmentOptions",
    "previewHash",
    "requiresHumanReview"
  ],
  "additionalProperties": false
}
