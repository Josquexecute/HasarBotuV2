{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "to": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 254,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      }
    },
    "cc": {
      "default": [],
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 254,
        "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
      }
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "attachments": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "enum": [
              "document_version",
              "photo"
            ]
          },
          "resourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          }
        },
        "required": [
          "resourceType",
          "resourceId"
        ],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "expectedVersion",
    "to",
    "cc",
    "subject",
    "body",
    "attachments",
    "reason",
    "confirmed"
  ],
  "additionalProperties": false
}
