{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean",
      "const": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "validation_error",
            "unauthorized",
            "forbidden",
            "not_found",
            "conflict",
            "version_conflict",
            "idempotency_conflict",
            "workspace_conflict",
            "workspace_stale",
            "file_operation_conflict",
            "file_operation_stale",
            "destination_conflict",
            "lifecycle_conflict",
            "lifecycle_stale",
            "lifecycle_blocked",
            "policy_analysis_conflict",
            "policy_analysis_stale",
            "policy_source_invalid",
            "pdf_extraction_conflict",
            "pdf_extraction_stale",
            "pdf_source_invalid",
            "pdf_limit_exceeded",
            "ocr_conflict",
            "ocr_stale",
            "ocr_source_invalid",
            "ocr_engine_unavailable",
            "ocr_limit_exceeded",
            "ai_provider_disabled",
            "ai_budget_exceeded",
            "ai_output_invalid",
            "ai_evidence_invalid",
            "ai_extraction_conflict",
            "ai_extraction_stale",
            "ai_candidate_review_conflict",
            "ai_candidate_review_stale",
            "ai_candidate_promotion_blocked",
            "ai_candidate_promotion_stale",
            "traffic_value_loss_conflict",
            "traffic_value_loss_stale",
            "traffic_value_loss_source_invalid",
            "traffic_value_loss_approval_blocked",
            "traffic_value_loss_report_not_approved",
            "traffic_value_loss_report_preview_stale",
            "traffic_value_loss_report_exists",
            "traffic_value_loss_report_verification_failed",
            "traffic_value_loss_report_invalid",
            "manual_recovery_required",
            "rate_limited",
            "service_unavailable",
            "internal_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message",
        "fieldErrors"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ok",
    "error"
  ],
  "additionalProperties": false
}
