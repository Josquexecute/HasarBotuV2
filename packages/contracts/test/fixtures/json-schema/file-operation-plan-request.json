{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operationType": {
      "type": "string",
      "enum": [
        "rename_case_workspace",
        "move_case_workspace"
      ]
    },
    "destinationStorageRootKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "destinationRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "x-hasarbotu-runtime-validation": "safe-relative-path"
    },
    "expectedLocationVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "operationType",
    "destinationStorageRootKey",
    "destinationRelativePath",
    "expectedLocationVersion"
  ],
  "additionalProperties": false
}
