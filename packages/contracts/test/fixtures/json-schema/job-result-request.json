{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "verified",
        "missing",
        "failed"
      ]
    },
    "observedHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5368709120
    },
    "errorCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$"
    }
  },
  "required": [
    "outcome"
  ],
  "additionalProperties": false
}
