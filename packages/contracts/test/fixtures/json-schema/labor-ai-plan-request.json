{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "damageDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "providerId": {
      "type": "string",
      "enum": [
        "deterministic-success",
        "deterministic-invalid-schema",
        "deterministic-timeout",
        "deterministic-failure",
        "gemini-generate-content"
      ]
    }
  },
  "required": [
    "damageDescription",
    "providerId"
  ],
  "additionalProperties": false
}
