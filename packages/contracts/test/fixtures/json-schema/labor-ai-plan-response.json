{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "caseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "baseSheetVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "providerId": {
      "type": "string",
      "enum": [
        "deterministic-success",
        "deterministic-invalid-schema",
        "deterministic-timeout",
        "deterministic-failure",
        "gemini-generate-content"
      ]
    },
    "providerVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "modelId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "promptTemplateVersion": {
      "type": "string",
      "const": "labor-ai-draft/1.0.0"
    },
    "outputSchemaVersion": {
      "type": "string",
      "const": "labor-ai-suggestion/1.0.0"
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "privacy": {
      "type": "object",
      "properties": {
        "externalProvider": {
          "type": "boolean"
        },
        "policyVersion": {
          "type": "string",
          "enum": [
            "labor-ai-pii-redaction/1.0.0",
            "labor-ai-pii/local-only"
          ]
        },
        "outboundPayloadHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "outboundInputCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200000
        },
        "redactedValueCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "redactedCategories": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "address",
              "email",
              "iban",
              "name",
              "phone",
              "plate",
              "reference_number",
              "tax_identity",
              "turkish_identity",
              "vehicle_identity"
            ]
          }
        },
        "retentionMode": {
          "type": "string",
          "enum": [
            "local_only",
            "store_false",
            "free_tier_product_improvement"
          ]
        },
        "warnings": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "required": [
        "externalProvider",
        "policyVersion",
        "outboundPayloadHash",
        "outboundInputCharacters",
        "redactedValueCount",
        "redactedCategories",
        "retentionMode",
        "warnings"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "providerAvailable": {
          "type": "boolean"
        },
        "providerAllowed": {
          "type": "boolean"
        },
        "estimatedCostMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currentMonthCostMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "monthlyBudgetMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "perRequestBudgetMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allowed": {
          "type": "boolean"
        },
        "reasonCode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "AI_PROVIDER_DISABLED",
                "AI_BUDGET_EXCEEDED",
                "AI_PROVIDER_NOT_CONFIGURED"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "enabled",
        "providerAvailable",
        "providerAllowed",
        "estimatedCostMinor",
        "currentMonthCostMinor",
        "monthlyBudgetMinor",
        "perRequestBudgetMinor",
        "allowed",
        "reasonCode"
      ],
      "additionalProperties": false
    },
    "canStart": {
      "type": "boolean"
    },
    "requiresExplicitEgressConfirmation": {
      "type": "boolean"
    },
    "requiresHumanReview": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "caseId",
    "caseVersion",
    "baseSheetVersion",
    "providerId",
    "providerVersion",
    "modelId",
    "promptTemplateVersion",
    "outputSchemaVersion",
    "planHash",
    "privacy",
    "budget",
    "canStart",
    "requiresExplicitEgressConfirmation",
    "requiresHumanReview"
  ],
  "additionalProperties": false
}
