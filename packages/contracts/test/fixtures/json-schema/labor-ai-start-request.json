{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "damageDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "providerId": {
      "type": "string",
      "enum": [
        "deterministic-success",
        "deterministic-invalid-schema",
        "deterministic-timeout",
        "deterministic-failure",
        "gemini-generate-content"
      ]
    },
    "expectedCaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedSheetVersion": {
      "default": null,
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "planHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "damageDescription",
    "providerId",
    "expectedCaseVersion",
    "expectedSheetVersion",
    "planHash",
    "confirmed"
  ],
  "additionalProperties": false
}
