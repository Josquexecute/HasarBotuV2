{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "sourceSheetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "sourceSheetVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operationTypesVersion": {
      "type": "string",
      "const": "labor-operation-types/1.0.0"
    },
    "outputSchemaVersion": {
      "type": "string",
      "const": "labor-allocation-suggestion/2.0.0"
    },
    "lines": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "partAmountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "laborAmountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "allocations": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operationType": {
                  "type": "string",
                  "enum": [
                    "repair",
                    "replace",
                    "remove_install",
                    "paint",
                    "consumable",
                    "calibration",
                    "related_operation",
                    "other"
                  ]
                },
                "amountMinor": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000000000
                }
              },
              "required": [
                "operationType",
                "amountMinor"
              ],
              "additionalProperties": false
            }
          },
          "controlRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "lineOrdinal",
          "description",
          "action",
          "partAmountMinor",
          "laborAmountMinor",
          "allocations",
          "controlRequired"
        ],
        "additionalProperties": false
      }
    },
    "selectedCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "controlRequiredCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "applied": {
      "type": "boolean",
      "const": false
    },
    "requiresHumanReview": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "runId",
    "caseId",
    "sourceSheetId",
    "sourceSheetVersion",
    "operationTypesVersion",
    "outputSchemaVersion",
    "lines",
    "selectedCount",
    "controlRequiredCount",
    "applied",
    "requiresHumanReview"
  ],
  "additionalProperties": false
}
