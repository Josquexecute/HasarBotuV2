{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fields": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "insurerId": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetSheet": {
          "default": null,
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 31
            },
            {
              "type": "null"
            }
          ]
        },
        "identityChecks": {
          "default": {
            "plate": false,
            "officeNumber": false
          },
          "type": "object",
          "properties": {
            "plate": {
              "type": "boolean"
            },
            "officeNumber": {
              "type": "boolean"
            }
          },
          "required": [
            "plate",
            "officeNumber"
          ],
          "additionalProperties": false
        },
        "columns": {
          "minItems": 1,
          "maxItems": 24,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false
          }
        },
        "mapping": {
          "type": "object",
          "properties": {
            "bodywork": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "mechanical": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "electrical": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "upholstery_lock": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "glass": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "calibration": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "repair": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            },
            "paint": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "bodywork",
            "mechanical",
            "electrical",
            "upholstery_lock",
            "glass",
            "calibration",
            "repair",
            "paint"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "insurerId",
        "targetSheet",
        "identityChecks",
        "columns",
        "mapping"
      ],
      "additionalProperties": false
    },
    "expectedVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "fields",
    "expectedVersion",
    "reason",
    "confirmed"
  ],
  "additionalProperties": false
}
