{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedCaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "items": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "partAmountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "laborAmountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000000
          },
          "partCode": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "partCodeSource": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "user_entered",
                  "dictionary_suggested"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "damageRegion": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "description",
          "action",
          "partAmountMinor",
          "laborAmountMinor",
          "partCode",
          "partCodeSource",
          "damageRegion"
        ],
        "additionalProperties": false
      }
    },
    "laborAiSuggestionRunId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "expectedCaseVersion",
    "items",
    "laborAiSuggestionRunId",
    "confirmed"
  ],
  "additionalProperties": false
}
