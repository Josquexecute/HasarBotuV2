{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applicationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "workbookRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "x-hasarbotu-runtime-validation": "safe-relative-path"
    },
    "expectedSourceSha256": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cell": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}[1-9]\\d{0,6}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "cell",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "identityCellReferences": {
      "type": "object",
      "properties": {
        "plateCell": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{1,3}[1-9]\\d{0,6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "officeNumberCell": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{1,3}[1-9]\\d{0,6}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "plateCell",
        "officeNumberCell"
      ],
      "additionalProperties": false
    },
    "sourceRows": {
      "minItems": 1,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lineOrdinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "rowNumber": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1048576
          }
        },
        "required": [
          "lineOrdinal",
          "rowNumber"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "applicationId",
    "profileId",
    "workbookRelativePath",
    "expectedSourceSha256",
    "headers",
    "identityCellReferences",
    "sourceRows"
  ],
  "additionalProperties": false
}
