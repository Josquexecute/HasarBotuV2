{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "extractionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "segmentIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "type": {
            "type": "string",
            "enum": [
              "title",
              "heading",
              "clause",
              "paragraph",
              "list",
              "table",
              "header_footer",
              "unknown"
            ]
          },
          "startOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffset": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "extractionId",
          "pageId",
          "pageNumber",
          "segmentIndex",
          "type",
          "startOffset",
          "endOffset",
          "text",
          "textHash"
        ],
        "additionalProperties": false
      }
    },
    "pageInfo": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "page",
        "pageSize",
        "totalItems",
        "totalPages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "items",
    "pageInfo"
  ],
  "additionalProperties": false
}
