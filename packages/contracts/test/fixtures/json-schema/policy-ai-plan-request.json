{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "providerId": {
      "type": "string",
      "enum": [
        "deterministic-success",
        "deterministic-invalid-schema",
        "deterministic-timeout",
        "deterministic-failure",
        "deterministic-prompt-injection-attempt",
        "openai-responses",
        "gemini-generate-content"
      ]
    },
    "sources": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "const": "pdf_text"
              },
              "extractionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              "segmentId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              }
            },
            "required": [
              "sourceType",
              "extractionId",
              "segmentId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sourceType": {
                "type": "string",
                "const": "ocr"
              },
              "ocrRunId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              "elementId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              }
            },
            "required": [
              "sourceType",
              "ocrRunId",
              "elementId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "allowHistorical": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "providerId",
    "sources",
    "allowHistorical"
  ],
  "additionalProperties": false,
  "x-hasarbotu-runtime-validation": "unique-source-selection"
}
