{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ocrRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "ocrRunVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pages": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "textPageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_candidate",
              "partial",
              "low_confidence",
              "unreadable",
              "unsupported",
              "failed",
              "control_required"
            ]
          },
          "languageMode": {
            "type": "string",
            "enum": [
              "tur",
              "eng",
              "tur+eng"
            ]
          },
          "imageWidth": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "imageHeight": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "renderDpi": {
            "type": "integer",
            "minimum": 72,
            "maximum": 600
          },
          "rotationDegrees": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "deskewDegrees": {
            "type": "number",
            "minimum": -15,
            "maximum": 15
          },
          "threshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "rawOcrText": {
            "type": "string",
            "maxLength": 200000
          },
          "rawTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalizedText": {
            "type": "string",
            "maxLength": 200000
          },
          "normalizedTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "meanConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minimumConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "qualityStatus": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "insufficient",
              "control_required"
            ]
          },
          "readingOrderQuality": {
            "type": "string",
            "enum": [
              "reliable",
              "probable",
              "ambiguous",
              "control_required"
            ]
          },
          "compositeStatus": {
            "type": "string",
            "enum": [
              "pdf_text_only",
              "ocr_only",
              "combined_non_overlapping",
              "conflict_detected",
              "control_required"
            ]
          },
          "qualityReasonCode": {
            "type": "string",
            "enum": [
              "quality_good",
              "low_confidence",
              "insufficient_text",
              "empty_result",
              "suspicious_characters",
              "ocr_failed"
            ]
          },
          "requiresHumanReview": {
            "type": "boolean"
          },
          "lowConfidenceWordCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unreadableRegionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "processingDurationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          },
          "elements": {
            "maxItems": 20000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "elementIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19999
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "block",
                    "line",
                    "word"
                  ]
                },
                "parentIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "readingOrder": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "startOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endOffset": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "textHash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "bbox": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "y": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "elementIndex",
                "type",
                "parentIndex",
                "readingOrder",
                "startOffset",
                "endOffset",
                "textHash",
                "confidence",
                "bbox"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "textPageId",
          "pageNumber",
          "status",
          "languageMode",
          "imageWidth",
          "imageHeight",
          "renderDpi",
          "rotationDegrees",
          "deskewDegrees",
          "threshold",
          "rawOcrText",
          "rawTextHash",
          "normalizedText",
          "normalizedTextHash",
          "meanConfidence",
          "minimumConfidence",
          "qualityStatus",
          "readingOrderQuality",
          "compositeStatus",
          "qualityReasonCode",
          "requiresHumanReview",
          "lowConfidenceWordCount",
          "unreadableRegionCount",
          "processingDurationMs",
          "elements"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ocrRunId",
    "ocrRunVersion",
    "sequence",
    "pages"
  ],
  "additionalProperties": false
}
