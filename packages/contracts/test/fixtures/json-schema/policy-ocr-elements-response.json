{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "ocrRunId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "type": {
            "type": "string",
            "enum": [
              "block",
              "line",
              "word"
            ]
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "elementIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "readingOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "startOffset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endOffset": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "textHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "bbox": {
            "type": "object",
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "y": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "sourceLayer": {
            "type": "string",
            "const": "ocr"
          }
        },
        "required": [
          "id",
          "ocrRunId",
          "pageId",
          "pageNumber",
          "type",
          "parentId",
          "elementIndex",
          "readingOrder",
          "startOffset",
          "endOffset",
          "text",
          "textHash",
          "confidence",
          "bbox",
          "sourceLayer"
        ],
        "additionalProperties": false
      }
    },
    "pageInfo": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "page",
        "pageSize",
        "totalItems",
        "totalPages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "items",
    "pageInfo"
  ],
  "additionalProperties": false
}
