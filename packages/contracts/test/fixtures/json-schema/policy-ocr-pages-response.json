{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "ocrRunId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "textPageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_candidate",
              "partial",
              "low_confidence",
              "unreadable",
              "unsupported",
              "failed",
              "control_required"
            ]
          },
          "languageMode": {
            "type": "string",
            "enum": [
              "tur",
              "eng",
              "tur+eng"
            ]
          },
          "imageWidth": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "imageHeight": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "renderDpi": {
            "type": "integer",
            "minimum": 72,
            "maximum": 600
          },
          "rotationDegrees": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 90
              },
              {
                "type": "number",
                "const": 180
              },
              {
                "type": "number",
                "const": 270
              }
            ]
          },
          "deskewDegrees": {
            "type": "number",
            "minimum": -15,
            "maximum": 15
          },
          "threshold": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "rawOcrText": {
            "type": "string",
            "maxLength": 200000
          },
          "rawTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalizedText": {
            "type": "string",
            "maxLength": 200000
          },
          "normalizedTextHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "normalizedCharacterCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "meanConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "minimumConfidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "qualityStatus": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "insufficient",
              "control_required"
            ]
          },
          "readingOrderQuality": {
            "type": "string",
            "enum": [
              "reliable",
              "probable",
              "ambiguous",
              "control_required"
            ]
          },
          "compositeStatus": {
            "type": "string",
            "enum": [
              "pdf_text_only",
              "ocr_only",
              "combined_non_overlapping",
              "conflict_detected",
              "control_required"
            ]
          },
          "qualityReasonCode": {
            "type": "string",
            "enum": [
              "quality_good",
              "low_confidence",
              "insufficient_text",
              "empty_result",
              "suspicious_characters",
              "ocr_failed"
            ]
          },
          "requiresHumanReview": {
            "type": "boolean"
          },
          "blockCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lineCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "wordCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lowConfidenceWordCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "unreadableRegionCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "processingDurationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600000
          }
        },
        "required": [
          "id",
          "ocrRunId",
          "textPageId",
          "pageNumber",
          "status",
          "languageMode",
          "imageWidth",
          "imageHeight",
          "renderDpi",
          "rotationDegrees",
          "deskewDegrees",
          "threshold",
          "rawOcrText",
          "rawTextHash",
          "normalizedText",
          "normalizedTextHash",
          "normalizedCharacterCount",
          "meanConfidence",
          "minimumConfidence",
          "qualityStatus",
          "readingOrderQuality",
          "compositeStatus",
          "qualityReasonCode",
          "requiresHumanReview",
          "blockCount",
          "lineCount",
          "wordCount",
          "lowConfidenceWordCount",
          "unreadableRegionCount",
          "processingDurationMs"
        ],
        "additionalProperties": false
      }
    },
    "pageInfo": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "totalItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalPages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "page",
        "pageSize",
        "totalItems",
        "totalPages"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "items",
    "pageInfo"
  ],
  "additionalProperties": false
}
