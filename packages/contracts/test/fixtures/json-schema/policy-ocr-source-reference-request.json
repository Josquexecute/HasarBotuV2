{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "pageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "blockId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lineId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "wordId": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "startOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endOffset": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sectionHeading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "clauseIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "policy",
        "endorsement",
        "general_conditions",
        "special_conditions",
        "notice_form",
        "external_reference"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": [
    "sourceKey",
    "pageId",
    "blockId",
    "lineId",
    "wordId",
    "startOffset",
    "endOffset",
    "sectionHeading",
    "clauseIdentifier",
    "sourceType",
    "confidence"
  ],
  "additionalProperties": false
}
