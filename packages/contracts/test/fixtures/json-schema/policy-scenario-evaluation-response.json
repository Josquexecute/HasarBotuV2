              "id",
              "conflictType",
              "affectedTopic",
              "sourceAId",
              "sourceBId",
              "explanation",
              "severity",
              "resolutionStatus",
              "resolvedBy",
              "resolvedAt",
              "resolutionReason",
              "version"
            ],
            "additionalProperties": false
          }
