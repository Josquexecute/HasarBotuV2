                      "collision",
                      "fire",
                      "theft",
                      "natural_disaster",
                      "flood",
                      "earthquake",
                      "terror",
                      "glass",
                      "key_loss",
                      "roadside_assistance",
                      "replacement_vehicle",
                      "mini_repair",
                      "mobile_repair",
                      "legal_protection",
                      "personal_accident",
                      "third_party_liability",
                      "loss_of_use",
                      "wrong_fuel",
                      "animal_damage",
                      "electronic_mechanical_damage",
                      "other"
