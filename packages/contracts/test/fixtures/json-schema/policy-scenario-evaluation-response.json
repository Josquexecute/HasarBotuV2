                  "documentId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
                  },
                  "documentVersionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
                  },
                  "pageNumber": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "sectionHeading": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "clauseIdentifier": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "rawExcerpt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "excerptHash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "locator": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sourceType": {
                    "type": "string",
                    "enum": [
                      "policy",
                      "endorsement",
                      "general_conditions",
                      "special_conditions",
                      "notice_form",
                      "external_reference"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
