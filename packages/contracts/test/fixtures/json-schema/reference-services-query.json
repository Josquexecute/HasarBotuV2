{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "insurerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
    },
    "evaluationDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    },
    "dateSource": {
      "default": "loss_date",
      "type": "string",
      "enum": [
        "loss_date",
        "policy_date"
      ]
    },
    "operation": {
      "default": "closure_documents",
      "type": "string",
      "enum": [
        "closure_documents",
        "deductible_assessment",
        "policy_assessment",
        "repair_authorization"
      ]
    }
  },
  "required": [
    "dateSource",
    "operation"
  ],
  "additionalProperties": false
}
