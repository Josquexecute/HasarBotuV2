{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evaluatedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    },
    "heavyOrTotalDamage": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "vehicle": {
      "type": "object",
      "properties": {
        "make": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            {
              "type": "null"
            }
          ]
        },
        "modelYear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            },
            {
              "type": "null"
            }
          ]
        },
        "mileage": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "usageType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "make",
        "model",
        "variant",
        "modelYear",
        "mileage",
        "usageType"
      ],
      "additionalProperties": false
    },
    "faultRateBasisPoints": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "preAccidentMarketValueMinor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "postRepairMarketValueMinor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "damageParts": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "partName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "repairAction": {
            "type": "string",
            "enum": [
              "repair_paint",
              "replace_paint",
              "paint",
              "replace",
              "paintless_repair"
            ]
          },
          "priorDamage": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [
          "partCode",
          "partName",
          "repairAction",
          "priorDamage"
        ],
        "additionalProperties": false
      }
    },
    "comparables": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "comparableKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "side": {
            "type": "string",
            "enum": [
              "pre_accident",
              "post_repair"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mileage": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "x-hasarbotu-runtime-validation": "calendar-date-validity"
          },
          "evidenceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "excluded": {
            "default": false,
            "type": "boolean"
          },
          "exclusionReason": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "comparableKey",
          "side",
          "amountMinor",
          "mileage",
          "observedAt",
          "evidenceKey",
          "excluded",
          "exclusionReason"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "document_version",
              "market_comparable",
              "sbm_history",
              "expert_observation"
            ]
          },
          "documentId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "documentVersionId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "externalReference": {
            "default": null,
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^https:\\/\\/(?![^/?#]*@)[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:[/?#][^\\s\\\\]*)?$"
                  },
                  {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500,
                    "pattern": "^ref:(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observedAt": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "x-hasarbotu-runtime-validation": "calendar-date-validity"
              },
              {
                "type": "null"
              }
            ]
          },
          "supports": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vehicle_identity",
                "mileage",
                "usage_type",
                "damage_parts",
                "prior_damage",
                "pre_accident_market_value",
                "post_repair_market_value",
                "fault_rate",
                "heavy_damage_status"
              ]
            }
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "verified",
              "control_required"
            ]
          },
          "conflict": {
            "default": false,
            "type": "boolean"
          },
          "notes": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidenceKey",
          "sourceType",
          "documentId",
          "documentVersionId",
          "externalReference",
          "sourceHash",
          "observedAt",
          "supports",
          "verificationStatus",
          "conflict",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "realMarket": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vehicleType": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "OTOMOBİL",
                    "TAKSİ",
                    "MİNİBÜS",
                    "OTOBÜS",
                    "KAMYONET",
                    "KAMYON",
                    "ÇEKİCİ",
                    "İŞ MAKİNESİ",
                    "TRAKTÖR",
                    "TARIM MAKİNESİ",
                    "ÖZEL AMAÇLI ARAÇ",
                    "RÖMORK",
                    "MOTORSİKLET",
                    "TANKER"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "vehicleGroupCode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "Ç",
                    "D",
                    "E",
                    "F"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "usageMetric": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "mileage",
                    "working_hours"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "usageValue": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "commercialOrRental": {
              "type": "boolean"
            },
            "previousDamageCount": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "marketValueMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "damageAmountMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "parts": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "stableRuleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "operation": {
                    "type": "string",
                    "enum": [
                      "replacement",
                      "repair",
                      "paint"
                    ]
                  },
                  "paintMode": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "full",
                          "local"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "newPartPriceMinor": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "repairLaborMinor": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "partPriceAvailability": {
                    "type": "string",
                    "enum": [
                      "available",
                      "unavailable"
                    ]
                  },
                  "priorPartState": {
                    "type": "string",
                    "enum": [
                      "none",
                      "previously_damaged",
                      "previously_repaired_detachable",
                      "previously_repaired_welded"
                    ]
                  },
                  "treatment": {
                    "type": "string",
                    "enum": [
                      "standard",
                      "accessory",
                      "paintless_repair",
                      "plastic_or_unpainted",
                      "superstructure"
                    ]
                  }
                },
                "required": [
                  "stableRuleId",
                  "operation",
                  "paintMode",
                  "newPartPriceMinor",
                  "repairLaborMinor",
                  "partPriceAvailability",
                  "priorPartState",
                  "treatment"
                ],
                "additionalProperties": false
              }
            },
            "eligibilityFacts": {
              "type": "object",
              "properties": {
                "antiqueOrCollector": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "priorHeavyDamage": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "currentHeavyOrTotalDamage": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "foreignPlate": {
                  "type": "boolean"
                },
                "foreignMarketEvidenceVerified": {
                  "type": "boolean"
                }
              },
              "required": [
                "antiqueOrCollector",
                "priorHeavyDamage",
                "currentHeavyOrTotalDamage",
                "foreignPlate",
                "foreignMarketEvidenceVerified"
              ],
              "additionalProperties": false
            },
            "prefillProvenance": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "enum": [
                      "accidentDate",
                      "vehicleType",
                      "vehicleGroupCode",
                      "modelYear",
                      "usageValue",
                      "commercialOrRental",
                      "marketValueMinor",
                      "damageAmountMinor",
                      "parts",
                      "previousDamageCount"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "case",
                      "approved_market_value",
                      "approved_damage",
                      "finalized_parts",
                      "finalized_paint",
                      "sbm_evidence",
                      "other_evidence",
                      "user_input"
                    ]
                  },
                  "sourceRevisionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "originalValue": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "newValue": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          }
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "overrideReason": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "field",
                  "source",
                  "sourceRevisionId",
                  "originalValue",
                  "newValue",
                  "overrideReason"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "vehicleType",
            "vehicleGroupCode",
            "usageMetric",
            "usageValue",
            "commercialOrRental",
            "previousDamageCount",
            "marketValueMinor",
            "damageAmountMinor",
            "parts",
            "eligibilityFacts",
            "prefillProvenance"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "ruleOverride": {
      "default": null,
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ruleIdentity": {
              "type": "string",
              "enum": [
                "real-market-analysis/2026-07-01/1.0.0",
                "traffic-value-loss-market-difference/2026.07.01.1"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "ruleIdentity",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmedPreviewHash": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "expectedVersion",
    "evaluatedOn",
    "heavyOrTotalDamage",
    "vehicle",
    "faultRateBasisPoints",
    "preAccidentMarketValueMinor",
    "postRepairMarketValueMinor",
    "damageParts",
    "comparables",
    "evidence",
    "realMarket",
    "ruleOverride",
    "confirmedPreviewHash"
  ],
  "additionalProperties": false
}
