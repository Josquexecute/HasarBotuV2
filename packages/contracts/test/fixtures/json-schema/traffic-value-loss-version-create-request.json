{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evaluatedOn": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-hasarbotu-runtime-validation": "calendar-date-validity"
    },
    "heavyOrTotalDamage": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "vehicle": {
      "type": "object",
      "properties": {
        "make": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 150
            },
            {
              "type": "null"
            }
          ]
        },
        "modelYear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2200
            },
            {
              "type": "null"
            }
          ]
        },
        "mileage": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            {
              "type": "null"
            }
          ]
        },
        "usageType": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "make",
        "model",
        "variant",
        "modelYear",
        "mileage",
        "usageType"
      ],
      "additionalProperties": false
    },
    "faultRateBasisPoints": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "preAccidentMarketValueMinor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "postRepairMarketValueMinor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "damageParts": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "partCode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "partName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "repairAction": {
            "type": "string",
            "enum": [
              "repair_paint",
              "replace_paint",
              "paint",
              "replace",
              "paintless_repair"
            ]
          },
          "priorDamage": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unknown"
            ]
          }
        },
        "required": [
          "partCode",
          "partName",
          "repairAction",
          "priorDamage"
        ],
        "additionalProperties": false
      }
    },
    "comparables": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "comparableKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "side": {
            "type": "string",
            "enum": [
              "pre_accident",
              "post_repair"
            ]
          },
          "amountMinor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mileage": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "x-hasarbotu-runtime-validation": "calendar-date-validity"
          },
          "evidenceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "excluded": {
            "default": false,
            "type": "boolean"
          },
          "exclusionReason": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "comparableKey",
          "side",
          "amountMinor",
          "mileage",
          "observedAt",
          "evidenceKey",
          "excluded",
          "exclusionReason"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "document_version",
              "market_comparable",
              "sbm_history",
              "expert_observation"
            ]
          },
          "documentId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "documentVersionId": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^(?!.*[.][.])[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "externalReference": {
            "default": null,
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "pattern": "^https:\\/\\/(?![^/?#]*@)[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:[/?#][^\\s\\\\]*)?$"
                  },
                  {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 500,
                    "pattern": "^ref:(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._/-]*$"
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "sourceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observedAt": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "x-hasarbotu-runtime-validation": "calendar-date-validity"
              },
              {
                "type": "null"
              }
            ]
          },
          "supports": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vehicle_identity",
                "mileage",
                "usage_type",
                "damage_parts",
                "prior_damage",
                "pre_accident_market_value",
                "post_repair_market_value",
                "fault_rate",
                "heavy_damage_status"
              ]
            }
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "verified",
              "control_required"
            ]
          },
          "conflict": {
            "default": false,
            "type": "boolean"
          },
          "notes": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "evidenceKey",
          "sourceType",
          "documentId",
          "documentVersionId",
          "externalReference",
          "sourceHash",
          "observedAt",
          "supports",
          "verificationStatus",
          "conflict",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "expectedVersion",
    "evaluatedOn",
    "heavyOrTotalDamage",
    "vehicle",
    "faultRateBasisPoints",
    "preAccidentMarketValueMinor",
    "postRepairMarketValueMinor",
    "damageParts",
    "comparables",
    "evidence"
  ],
  "additionalProperties": false
}
