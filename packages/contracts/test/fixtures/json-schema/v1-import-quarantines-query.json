{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string",
      "enum": [
        "claim_type_unresolved",
        "ambiguous_target",
        "genuine_evidence_conflict",
        "malformed_source"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved"
      ]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "pageSize": {
      "default": 25,
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "page",
    "pageSize"
  ],
  "additionalProperties": false
}
