{
  "name": "@hasarbotu/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 PostgreSQL baglanti havuzu, saglik kontrolu ve surumlu migration temeli",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "migrate:up": "node dist/run-migrations.js up",
    "migrate:down": "node dist/run-migrations.js down"
  },
  "dependencies": {
    "node-pg-migrate": "8.0.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0"
  }
}
