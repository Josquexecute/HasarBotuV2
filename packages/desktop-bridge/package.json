{
  "name": "@hasarbotu/desktop-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 masaüstü kabuğu için loopback aynı-origin köprüsü (Electron bağımsız)",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  }
}
