{
  "name": "@hasarbotu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 merkezi API iskeleti: Fastify tabanli health ve guvenli hata sinirlari",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pilot:gemini:policy": "tsx test-support/package29-gemini-live-pilot.ts"
  },
  "dependencies": {
    "@hasarbotu/contracts": "*",
    "@hasarbotu/database": "*",
    "@hasarbotu/domain": "*",
    "@napi-rs/canvas": "1.0.2",
    "argon2": "0.44.0",
    "fastify": "5.10.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@hasarbotu/file-agent": "*",
    "@types/node": "24.13.3",
    "tsx": "4.23.0"
  }
}
