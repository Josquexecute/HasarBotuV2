{
  "name": "@hasarbotu/file-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 File Agent: dosya doğrulama protokolü istemcisi (yalnız API üzerinden çalışır)",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hasarbotu/contracts": "*",
    "@hasarbotu/domain": "*",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.0"
  }
}
