{
  "name": "@hasarbotu/file-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "HasarBotu V2 File Agent: dosya doğrulama protokolü istemcisi (yalnız API üzerinden çalışır)",
  "engines": {
    "node": ">=24.15 <25"
  },
  "files": [
    "dist",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hasarbotu/contracts": "*",
    "@hasarbotu/domain": "*",
    "@napi-rs/canvas": "1.0.12",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "fflate": "0.8.3",
    "libheif-js": "1.23.5",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15"
  },
  "author": "Ömer Faruk İŞLEYEN",
  "license": "UNLICENSED"
}
